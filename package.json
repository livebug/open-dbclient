{
  "name": "open-dbclient",
  "displayName": "Open DB Client",
  "description": "Universal JDBC database client: connect, SQL IntelliSense, execute, export, table structure and health monitoring.",
  "version": "0.3.0",
  "publisher": "open-dbclient",
  "license": "MIT",
  "icon": "media/icon/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/livebug/open-dbclient.git"
  },
  "bugs": {
    "url": "https://github.com/livebug/open-dbclient/issues"
  },
  "homepage": "https://github.com/livebug/open-dbclient#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Data Science"
  ],
  "keywords": [
    "jdbc",
    "database",
    "sql",
    "mysql",
    "postgresql",
    "opengauss",
    "transwarp",
    "query",
    "export"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:sql"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "open-dbclient",
          "title": "%viewContainer.title%",
          "icon": "media/icon/database.svg"
        }
      ],
      "panel": [
        {
          "id": "open-dbclient.panel",
          "title": "%viewContainer.title%",
          "icon": "media/icon/database.svg"
        }
      ]
    },
    "views": {
      "open-dbclient": [
        {
          "id": "open-dbclient.connections",
          "name": "%view.connections%",
          "icon": "media/icon/database.svg"
        },
        {
          "id": "open-dbclient.history",
          "name": "%view.history%",
          "icon": "media/icon/history.svg"
        }
      ],
      "open-dbclient.panel": [
        {
          "id": "open-dbclient.variables",
          "name": "%view.variables%",
          "type": "webview",
          "icon": "media/icon/database.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "open-dbclient.connections",
        "contents": "%welcome.connections%"
      }
    ],
    "commands": [
      {
        "command": "open-dbclient.addConnection",
        "title": "%cmd.addConnection%",
        "category": "DB Client",
        "icon": "$(add)"
      },
      {
        "command": "open-dbclient.editConnection",
        "title": "%cmd.editConnection%",
        "category": "DB Client",
        "icon": "$(edit)"
      },
      {
        "command": "open-dbclient.duplicateConnection",
        "title": "%cmd.duplicateConnection%",
        "category": "DB Client",
        "icon": "$(copy)"
      },
      {
        "command": "open-dbclient.deleteConnection",
        "title": "%cmd.deleteConnection%",
        "category": "DB Client",
        "icon": "$(trash)"
      },
      {
        "command": "open-dbclient.testConnection",
        "title": "%cmd.testConnection%",
        "category": "DB Client"
      },
      {
        "command": "open-dbclient.connect",
        "title": "%cmd.connect%",
        "category": "DB Client",
        "icon": "$(plug)"
      },
      {
        "command": "open-dbclient.disconnect",
        "title": "%cmd.disconnect%",
        "category": "DB Client",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "open-dbclient.selectConnection",
        "title": "%cmd.selectConnection%",
        "category": "DB Client",
        "icon": "$(database)"
      },
      {
        "command": "open-dbclient.refreshNode",
        "title": "%cmd.refreshNode%",
        "category": "DB Client",
        "icon": "$(refresh)"
      },
      {
        "command": "open-dbclient.refreshAll",
        "title": "%cmd.refreshAll%",
        "category": "DB Client",
        "icon": "$(refresh)"
      },
      {
        "command": "open-dbclient.openQuery",
        "title": "%cmd.openQuery%",
        "category": "DB Client",
        "icon": "$(new-file)"
      },
      {
        "command": "open-dbclient.runQuery",
        "title": "%cmd.runQuery%",
        "category": "DB Client",
        "icon": "$(play)"
      },
      {
        "command": "open-dbclient.runAllQueries",
        "title": "%cmd.runAllQueries%",
        "category": "DB Client"
      },
      {
        "command": "open-dbclient.runStatement",
        "title": "%cmd.runStatement%",
        "category": "DB Client"
      },
      {
        "command": "open-dbclient.showVariables",
        "title": "%cmd.showVariables%",
        "category": "DB Client",
        "icon": "$(symbol-parameter)"
      },
      {
        "command": "open-dbclient.refreshVariables",
        "title": "%cmd.refreshVariables%",
        "category": "DB Client",
        "icon": "$(refresh)"
      },
      {
        "command": "open-dbclient.installMetadataQueries",
        "title": "%cmd.installMetadataQueries%",
        "category": "DB Client",
        "icon": "$(wand)"
      },
      {
        "command": "open-dbclient.runCustomAction",
        "title": "%cmd.runCustomAction%",
        "category": "DB Client",
        "icon": "$(play)"
      },
      {
        "command": "open-dbclient.runQueryFromTree",
        "title": "%cmd.runQueryFromTree%",
        "category": "DB Client",
        "icon": "$(play)"
      },
      {
        "command": "open-dbclient.cancelQuery",
        "title": "%cmd.cancelQuery%",
        "category": "DB Client"
      },
      {
        "command": "open-dbclient.exportResult",
        "title": "%cmd.exportResult%",
        "category": "DB Client",
        "icon": "$(desktop-download)"
      },
      {
        "command": "open-dbclient.exportTable",
        "title": "%cmd.exportTable%",
        "category": "DB Client",
        "icon": "$(desktop-download)"
      },
      {
        "command": "open-dbclient.viewColumns",
        "title": "%cmd.viewColumns%",
        "category": "DB Client",
        "icon": "$(list-flat)"
      },
      {
        "command": "open-dbclient.viewIndexes",
        "title": "%cmd.viewIndexes%",
        "category": "DB Client",
        "icon": "$(list-ordered)"
      },
      {
        "command": "open-dbclient.generateDdl",
        "title": "%cmd.generateDdl%",
        "category": "DB Client",
        "icon": "$(code)"
      },
      {
        "command": "open-dbclient.copyName",
        "title": "%cmd.copyName%",
        "category": "DB Client",
        "icon": "$(clippy)"
      },
      {
        "command": "open-dbclient.addDriverJar",
        "title": "%cmd.addDriverJar%",
        "category": "DB Client",
        "icon": "$(add)"
      },
      {
        "command": "open-dbclient.openDriverFolder",
        "title": "%cmd.openDriverFolder%",
        "category": "DB Client",
        "icon": "$(folder-opened)"
      },
      {
        "command": "open-dbclient.downloadDriver",
        "title": "%cmd.downloadDriver%",
        "category": "DB Client",
        "icon": "$(cloud-download)"
      },
      {
        "command": "open-dbclient.listDrivers",
        "title": "%cmd.listDrivers%",
        "category": "DB Client"
      },
      {
        "command": "open-dbclient.restartBridge",
        "title": "%cmd.restartBridge%",
        "category": "DB Client",
        "icon": "$(debug-restart)"
      },
      {
        "command": "open-dbclient.showHealth",
        "title": "%cmd.showHealth%",
        "category": "DB Client",
        "icon": "$(pulse)"
      },
      {
        "command": "open-dbclient.refreshMetadataCache",
        "title": "%cmd.refreshMetadataCache%",
        "category": "DB Client",
        "icon": "$(sync)"
      },
      {
        "command": "open-dbclient.filterTree",
        "title": "%cmd.filterTree%",
        "category": "DB Client",
        "icon": "$(filter)"
      },
      {
        "command": "open-dbclient.clearFilter",
        "title": "%cmd.clearFilter%",
        "category": "DB Client",
        "icon": "$(clear-all)"
      },
      {
        "command": "open-dbclient.insertHistoryEntry",
        "title": "%cmd.insertHistoryEntry%",
        "category": "DB Client"
      },
      {
        "command": "open-dbclient.deleteHistoryEntry",
        "title": "%cmd.deleteHistoryEntry%",
        "category": "DB Client",
        "icon": "$(close)"
      },
      {
        "command": "open-dbclient.clearHistory",
        "title": "%cmd.clearHistory%",
        "category": "DB Client",
        "icon": "$(clear-all)"
      }
    ],
    "keybindings": [
      {
        "command": "open-dbclient.runQuery",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "open-dbclient.sqlFile && open-dbclient.hasActiveConnection"
      },
      {
        "command": "open-dbclient.runAllQueries",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "open-dbclient.sqlFile && open-dbclient.hasActiveConnection"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "open-dbclient.refreshVariables",
          "when": "view == open-dbclient.variables",
          "group": "navigation@1"
        },
        {
          "command": "open-dbclient.addConnection",
          "when": "view == open-dbclient.connections",
          "group": "navigation@1"
        },
        {
          "command": "open-dbclient.refreshAll",
          "when": "view == open-dbclient.connections",
          "group": "navigation@2"
        },
        {
          "command": "open-dbclient.filterTree",
          "when": "view == open-dbclient.connections",
          "group": "navigation@3"
        },
        {
          "command": "open-dbclient.clearFilter",
          "when": "view == open-dbclient.connections",
          "group": "navigation@4"
        },
        {
          "command": "open-dbclient.showHealth",
          "when": "view == open-dbclient.connections",
          "group": "navigation@5"
        },
        {
          "command": "open-dbclient.openDriverFolder",
          "when": "view == open-dbclient.connections",
          "group": "9_manage@1"
        },
        {
          "command": "open-dbclient.addDriverJar",
          "when": "view == open-dbclient.connections",
          "group": "9_manage@2"
        },
        {
          "command": "open-dbclient.downloadDriver",
          "when": "view == open-dbclient.connections",
          "group": "9_manage@3"
        },
        {
          "command": "open-dbclient.restartBridge",
          "when": "view == open-dbclient.connections",
          "group": "9_manage@4"
        },
        {
          "command": "open-dbclient.clearHistory",
          "when": "view == open-dbclient.history",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "open-dbclient.connect",
          "when": "view == open-dbclient.connections && viewItem == connection.disconnected",
          "group": "inline@1"
        },
        {
          "command": "open-dbclient.disconnect",
          "when": "view == open-dbclient.connections && viewItem == connection.connected",
          "group": "inline@1"
        },
        {
          "command": "open-dbclient.openQuery",
          "when": "view == open-dbclient.connections && viewItem =~ /^connection/",
          "group": "inline@2"
        },
        {
          "command": "open-dbclient.runQueryFromTree",
          "when": "view == open-dbclient.connections && viewItem =~ /^(table|view)$/",
          "group": "inline@1"
        },
        {
          "command": "open-dbclient.runCustomAction",
          "when": "view == open-dbclient.connections && viewItem =~ /^(table|view|column)$/",
          "group": "inline@3"
        },
        {
          "command": "open-dbclient.generateDdl",
          "when": "view == open-dbclient.connections && viewItem =~ /^(table|view)$/",
          "group": "inline@2"
        },
        {
          "command": "open-dbclient.editConnection",
          "when": "view == open-dbclient.connections && viewItem =~ /^connection/",
          "group": "1_modify@1"
        },
        {
          "command": "open-dbclient.duplicateConnection",
          "when": "view == open-dbclient.connections && viewItem == connection.disconnected",
          "group": "1_modify@2"
        },
        {
          "command": "open-dbclient.testConnection",
          "when": "view == open-dbclient.connections && viewItem == connection.disconnected",
          "group": "1_modify@3"
        },
        {
          "command": "open-dbclient.deleteConnection",
          "when": "view == open-dbclient.connections && viewItem == connection.disconnected",
          "group": "1_modify@4"
        },
        {
          "command": "open-dbclient.refreshNode",
          "when": "view == open-dbclient.connections && viewItem =~ /^(connection|folder|table|view|catalog|schema)/",
          "group": "navigation@1"
        },
        {
          "command": "open-dbclient.viewColumns",
          "when": "view == open-dbclient.connections && viewItem =~ /^(table|view)$/",
          "group": "2_view@1"
        },
        {
          "command": "open-dbclient.viewIndexes",
          "when": "view == open-dbclient.connections && viewItem == table",
          "group": "2_view@2"
        },
        {
          "command": "open-dbclient.exportTable",
          "when": "view == open-dbclient.connections && viewItem =~ /^(table|view)$/",
          "group": "2_view@3"
        },
        {
          "command": "open-dbclient.copyName",
          "when": "view == open-dbclient.connections && viewItem =~ /^(table|view|column|catalog|schema)$/",
          "group": "3_copy@1"
        },
        {
          "command": "open-dbclient.insertHistoryEntry",
          "when": "view == open-dbclient.history && viewItem == history",
          "group": "inline@1"
        },
        {
          "command": "open-dbclient.deleteHistoryEntry",
          "when": "view == open-dbclient.history && viewItem == history",
          "group": "inline@2"
        }
      ],
      "editor/context": [
        {
          "command": "open-dbclient.runQuery",
          "when": "open-dbclient.sqlFile",
          "group": "open-dbclient@1"
        },
        {
          "command": "open-dbclient.runAllQueries",
          "when": "open-dbclient.sqlFile",
          "group": "open-dbclient@2"
        },
        {
          "command": "open-dbclient.cancelQuery",
          "when": "open-dbclient.sqlFile",
          "group": "open-dbclient@3"
        }
      ],
      "commandPalette": [
        {
          "command": "open-dbclient.refreshNode",
          "when": "false"
        },
        {
          "command": "open-dbclient.runQueryFromTree",
          "when": "false"
        },
        {
          "command": "open-dbclient.insertHistoryEntry",
          "when": "false"
        },
        {
          "command": "open-dbclient.deleteHistoryEntry",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "open-dbclient.javaHome": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.javaHome.description%",
          "scope": "machine-overridable"
        },
        "open-dbclient.javaArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%config.javaArgs.description%",
          "scope": "machine-overridable"
        },
        "open-dbclient.jvmMaxHeap": {
          "type": "string",
          "default": "1g",
          "markdownDescription": "%config.jvmMaxHeap.description%"
        },
        "open-dbclient.driverPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%config.driverPaths.description%",
          "scope": "machine-overridable"
        },
        "open-dbclient.driverClassNames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%config.driverClassNames.description%",
          "scope": "machine-overridable"
        },
        "open-dbclient.connection.poolSize": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "maximum": 32,
          "markdownDescription": "%config.poolSize.description%"
        },
        "open-dbclient.query.fetchSize": {
          "type": "number",
          "default": 200,
          "minimum": 10,
          "maximum": 10000,
          "markdownDescription": "%config.fetchSize.description%"
        },
        "open-dbclient.query.confirmDangerous": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.confirmDangerous.description%"
        },
        "open-dbclient.query.maxRows": {
          "type": "number",
          "default": 100000,
          "minimum": 0,
          "markdownDescription": "%config.maxRows.description%"
        },
        "open-dbclient.query.codeLens": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.codeLens.description%"
        },
        "open-dbclient.result.openIn": {
          "type": "string",
          "enum": [
            "below",
            "beside"
          ],
          "enumDescriptions": [
            "%config.resultOpenIn.below%",
            "%config.resultOpenIn.beside%"
          ],
          "default": "below",
          "markdownDescription": "%config.resultOpenIn.description%"
        },
        "open-dbclient.variables.pattern": {
          "type": "string",
          "default": "\\$\\{\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*\\}",
          "markdownDescription": "%config.variablePattern.description%"
        },
        "open-dbclient.metadata.queries": {
          "type": "array",
          "default": [],
          "markdownDescription": "%config.metadataQueries.description%",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "sql"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "%config.metadataQueries.id%"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "schemas",
                  "tables"
                ],
                "description": "%config.metadataQueries.kind%"
              },
              "match": {
                "type": "string",
                "description": "%config.metadataQueries.match%"
              },
              "sql": {
                "type": "string",
                "description": "%config.metadataQueries.sql%"
              }
            }
          }
        },
        "open-dbclient.metadata.timeoutSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "markdownDescription": "%config.metadataTimeoutSeconds.description%"
        },
        "open-dbclient.ddl.queries": {
          "type": "array",
          "default": [],
          "markdownDescription": "%config.ddlQueries.description%",
          "items": {
            "type": "object",
            "required": [
              "sql"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "%config.ddlQueries.id%"
              },
              "match": {
                "type": "string",
                "description": "%config.ddlQueries.match%"
              },
              "sql": {
                "type": "string",
                "description": "%config.ddlQueries.sql%"
              }
            }
          }
        },
        "open-dbclient.ddl.ifNotExists": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.ddlIfNotExists.description%"
        },
        "open-dbclient.ddl.indent": {
          "type": "string",
          "default": "    ",
          "markdownDescription": "%config.ddlIndent.description%"
        },
        "open-dbclient.ddl.includeIndexes": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.ddlIncludeIndexes.description%"
        },
        "open-dbclient.ddl.quoteIdentifiers": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.ddlQuoteIdentifiers.description%"
        },
        "open-dbclient.actions": {
          "type": "array",
          "default": [],
          "markdownDescription": "%config.actions.description%",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "sql"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "%config.actions.id%"
              },
              "label": {
                "type": "string",
                "description": "%config.actions.label%"
              },
              "description": {
                "type": "string",
                "description": "%config.actions.descriptionField%"
              },
              "icon": {
                "type": "string",
                "description": "%config.actions.icon%"
              },
              "appliesTo": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "table",
                    "view",
                    "column"
                  ]
                },
                "description": "%config.actions.appliesTo%"
              },
              "sql": {
                "type": "string",
                "description": "%config.actions.sql%"
              }
            }
          }
        },
        "open-dbclient.result.maxCacheBytes": {
          "type": "number",
          "default": 536870912,
          "markdownDescription": "%config.resultMaxCacheBytes.description%"
        },
        "open-dbclient.intellisense.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.intellisenseEnabled.description%"
        },
        "open-dbclient.intellisense.prefetchTables": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.intellisensePrefetchTables.description%"
        },
        "open-dbclient.intellisense.columnCacheLimit": {
          "type": "number",
          "default": 500,
          "minimum": 50,
          "markdownDescription": "%config.intellisenseColumnCacheLimit.description%"
        },
        "open-dbclient.health.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.healthEnabled.description%"
        },
        "open-dbclient.health.refreshInterval": {
          "type": "number",
          "default": 2000,
          "minimum": 500,
          "markdownDescription": "%config.healthRefreshInterval.description%"
        },
        "open-dbclient.health.showStatusBar": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.healthShowStatusBar.description%"
        },
        "open-dbclient.export.csv.delimiter": {
          "type": "string",
          "default": ",",
          "markdownDescription": "%config.csvDelimiter.description%"
        },
        "open-dbclient.export.csv.quoting": {
          "type": "string",
          "enum": [
            "minimal",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "%config.csvQuoting.minimal%",
            "%config.csvQuoting.always%",
            "%config.csvQuoting.never%"
          ],
          "default": "minimal",
          "markdownDescription": "%config.csvQuoting.description%"
        },
        "open-dbclient.export.csv.writeBom": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.csvWriteBom.description%"
        },
        "open-dbclient.export.excel.maxRowsPerSheet": {
          "type": "number",
          "default": 1048576,
          "markdownDescription": "%config.excelMaxRowsPerSheet.description%"
        },
        "open-dbclient.export.includeHeader": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.includeHeader.description%"
        },
        "open-dbclient.export.useColumnRemarks": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.useColumnRemarks.description%"
        },
        "open-dbclient.logLevel": {
          "type": "string",
          "default": "info",
          "enum": [
            "error",
            "warn",
            "info",
            "debug",
            "trace"
          ],
          "markdownDescription": "%config.logLevel.description%"
        }
      }
    }
  },
  "scripts": {
    "bridge:compile": "node scripts/build-bridge.mjs",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p media",
    "lint": "eslint src --ext ts",
    "pretest": "npm run compile && npm run bridge:compile",
    "docs": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-docs.mjs",
    "i18n": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-i18n.mjs",
    "checks": "npm run docs && npm run i18n",
    "test": "npm run typecheck && npm run checks && npm run bridge:test && npm run test:unit",
    "bridge:test": "node scripts/build-bridge.mjs --test",
    "test:unit": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.ts\"",
    "smoke": "node scripts/smoke-test.mjs",
    "verify": "npm test && npm run bridge:compile && npm run smoke --",
    "icon": "node scripts/make-icon.mjs",
    "package": "node scripts/package.mjs",
    "bundle:offline": "node scripts/make-offline-bundle.mjs",
    "doctor": "node scripts/offline-doctor.mjs",
    "vscode:prepublish": "npm run typecheck && npm run compile && npm run bridge:compile -- --release"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2"
  }
}
